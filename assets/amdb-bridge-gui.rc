  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Free Airport Mapping DB"
      VALUE "FileDescription", "AMDB Bridge"
      VALUE "FileVersion", "0.4.1"
      VALUE "InternalName", "amdb-bridge-gui"
      VALUE "LegalCopyright", "MIT licence"
      VALUE "OriginalFilename", "AMDB Bridge.exe"
      VALUE "ProductName", "AMDB Bridge"
      VALUE "ProductVersion", "0.4.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
