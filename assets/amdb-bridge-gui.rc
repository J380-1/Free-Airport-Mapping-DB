#define RT_MANIFEST 24

1 ICON "amdb-bridge.ico"
1 RT_MANIFEST "amdb-bridge-gui.manifest"

1 VERSIONINFO
FILEVERSION 0,4,1,0
PRODUCTVERSION 0,4,1,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
